<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@sigtoa.css" styleClass="fondo">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding><Insets bottom="12"/></padding>
            <Label fx:id="tituloLabel" text="Orden de trabajo" styleClass="titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="volverButton" text="Volver al menú" onAction="#volver"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="formulario">
            <VBox spacing="14" styleClass="tarjeta">
                <HBox fx:id="ordenExistenteBox" spacing="8" alignment="CENTER_LEFT">
                    <Label text="Orden *"/>
                    <ComboBox fx:id="ordenCombo" promptText="Número · fecha · labor · establecimiento" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="abrirOrdenButton" text="Abrir orden" onAction="#abrirOrden" styleClass="principal"/>
                </HBox>

                <GridPane fx:id="cabeceraGrid" hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Número" GridPane.rowIndex="0"/>
                    <Label fx:id="numeroLabel" text="Se genera al guardar" styleClass="dato" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Fecha *" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="fechaPicker" promptText="dd/mm/aaaa" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Campaña *" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="campaniaCombo" promptText="Seleccionar" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="Labor *" GridPane.rowIndex="3"/>
                    <ComboBox fx:id="laborCombo" promptText="Por ejemplo Pulverización terrestre" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    <Label text="Establecimiento *" GridPane.rowIndex="4"/>
                    <ComboBox fx:id="establecimientoCombo" promptText="Seleccionar" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label text="Contratista *" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="contratistaCombo" promptText="Seleccionar" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    <Label text="Depósito" GridPane.rowIndex="6"/>
                    <ComboBox fx:id="depositoCombo" promptText="Solo si la labor usa insumos" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label text="Remito N°" GridPane.rowIndex="7"/>
                    <TextField fx:id="remitoField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    <Label text="Convenio" GridPane.rowIndex="8"/>
                    <TextField fx:id="convenioField" promptText="Acuerdo con el dueño del campo" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                    <Label text="Comentarios" GridPane.rowIndex="9"/>
                    <TextArea fx:id="comentariosArea" prefRowCount="2" wrapText="true" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
                </GridPane>

                <Separator/>
                <Label text="Lotes de la orden *" styleClass="subtitulo"/>
                <HBox fx:id="loteEntradaBox" spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="loteCombo" promptText="Lote del establecimiento" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="cultivoCombo" promptText="Cultivo"/>
                    <TextField fx:id="superficieField" promptText="Superficie (ha)" prefColumnCount="7"/>
                    <Button fx:id="agregarLoteButton" text="Agregar lote" onAction="#agregarLote"/>
                    <Button fx:id="quitarLoteButton" text="Quitar lote" onAction="#quitarLote"/>
                </HBox>
                <TableView fx:id="lotesTable" prefHeight="120">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Agregá al menos un lote del establecimiento."/></placeholder>
                    <columns>
                        <TableColumn fx:id="loteColumn" text="Lote" sortable="false"/>
                        <TableColumn fx:id="cultivoColumn" text="Cultivo" sortable="false"/>
                        <TableColumn fx:id="superficieColumn" text="Superficie" sortable="false"/>
                    </columns>
                </TableView>
                <Button fx:id="guardarOrdenButton" text="Guardar orden" onAction="#guardarOrden" styleClass="principal"/>

                <Separator/>
                <VBox fx:id="insumosBox" spacing="8">
                    <Label text="Insumos a remitir" styleClass="subtitulo"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="insumoCombo" promptText="Insumo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <TextField fx:id="cantidadField" promptText="Cantidad" prefColumnCount="7"/>
                        <ComboBox fx:id="unidadCombo" editable="true" promptText="Unidad" prefWidth="90"/>
                        <Button fx:id="agregarInsumoButton" text="Agregar insumo" onAction="#agregarInsumo"/>
                        <Button text="Quitar insumo" onAction="#quitarInsumo"/>
                    </HBox>
                    <TableView fx:id="insumosTable" prefHeight="110">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="Una labor sin insumos, como la labranza, puede quedar vacía."/></placeholder>
                        <columns>
                            <TableColumn fx:id="insumoColumn" text="Insumo" sortable="false"/>
                            <TableColumn fx:id="grupoColumn" text="Grupo" sortable="false"/>
                            <TableColumn fx:id="cantidadColumn" text="Cantidad a remitir" sortable="false"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox fx:id="aplicacionesBox" spacing="8">
                    <Label text="Aplicaciones por lote" styleClass="subtitulo"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="aplicacionLoteCombo" promptText="Lote de la orden" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ComboBox fx:id="aplicacionInsumoCombo" promptText="Insumo de la orden" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <TextField fx:id="totalField" promptText="Total aplicado" prefColumnCount="7"/>
                        <Button fx:id="agregarAplicacionButton" text="Agregar aplicación" onAction="#agregarAplicacion"/>
                        <Button text="Quitar aplicación" onAction="#quitarAplicacion"/>
                    </HBox>
                    <TableView fx:id="aplicacionesTable" prefHeight="110">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="Todavía no hay aplicaciones."/></placeholder>
                        <columns>
                            <TableColumn fx:id="aplicacionLoteColumn" text="Lote" sortable="false"/>
                            <TableColumn fx:id="aplicacionInsumoColumn" text="Insumo" sortable="false"/>
                            <TableColumn fx:id="totalColumn" text="Total" sortable="false"/>
                            <TableColumn fx:id="dosisColumn" text="Dosis calculada" sortable="false"/>
                        </columns>
                    </TableView>
                    <Button fx:id="guardarAplicacionesButton" text="Guardar insumos y aplicaciones" onAction="#guardarAplicaciones" styleClass="principal"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="8">
            <padding><Insets top="12"/></padding>
            <Label fx:id="mensajeLabel" wrapText="true" maxWidth="Infinity" styleClass="mensaje"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Cerrar" cancelButton="true" onAction="#volver"/>
                <Label text="* Campos obligatorios. La orden debe incluir al menos un lote." styleClass="subtitulo"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
